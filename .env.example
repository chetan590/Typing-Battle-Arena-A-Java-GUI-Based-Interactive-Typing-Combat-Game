# =========================================================================
# Typing Battle Arena — Environment Configuration Template
# Copy this file to .env and configure your desired local settings.
# =========================================================================

# Directory path where local player match records and stats are stored.
# Default if unset: $HOME/.typing_battle_arena
TYPING_BATTLE_DATA_DIR=./data

# Initial audio state: set to true or 1 to mute audio on launch (useful for headless / CI / testing)
# Default: false
TYPING_BATTLE_MUTE=false

# Optional debug log level (INFO, DEBUG, ERROR)
TYPING_BATTLE_LOG_LEVEL=INFO

